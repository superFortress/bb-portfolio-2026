{
    "compilerOptions": {
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "resolvePackageJsonImports": true,
        "paths": {
            "#assets/vector/*": ["./src/assets/vector/*"],
            "#components/*": ["./src/components/*"],
            "#resources/*": ["./src/resources/*"],
            "#utils/*": ["./src/utils/*"]
        }
    },
    "include": [
        "src"
    ]
}